{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordinate System Convention",
  "description": "Schema for the coordinate system convention",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "description": "Zarr format version"
    },
    "node_type": {
      "type": "string",
      "enum": ["array", "group"],
      "description": "Type of Zarr node"
    },
    "shape": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "attributes": {
      "type": "object",
      "description": "Zarr attributes containing convention metadata and properties",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "description": "Array of convention metadata objects",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          }
        },
        "cs": {
          "$ref": "#/$defs/cs"
        }
      },
      "required": ["zarr_conventions", "cs"]
    }
  },
  "required": ["zarr_format", "node_type", "attributes"],
  "additionalProperties": true,
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "Convention metadata object for use in zarr_conventions array",
      "properties": {
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/R-CF/zarr_convention_cs/tags/v1/schema.json",
          "description": "URL to the JSON Schema definition for this convention"
        },
        "spec_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/R-CF/zarr_convention_cs/tags/v1/README.md",
          "description": "URL to the full specification document"
        },
        "uuid": {
          "type": "string",
          "const": "e4dbf0b7-7a00-4ce6-b23e-484292014ab4",
          "description": "UUID that permanently identifies this convention"
        },
        "name": {
          "type": "string",
          "description": "cs"
        },
        "description": {
          "type": "string",
          "const": "Coordinate system convention for Zarr arrays",
          "description": "Convention to assign semantic meaning to the dimensions of Zarr arrays, using axes and coordinates"
        }
      },
      "anyOf": [
        { "required": ["schema_url"] },
        { "required": ["spec_url"] },
        { "required": ["uuid"] }
      ],
      "additionalProperties": false
    },
    "cs": {
      "type": "object",
      "description": "Coordinate system for n-dimensional arrays",
      "properties": {
        "name": {
          "type": "string",
          "description": "Descriptive name for the coordinate system. Optional for arrays, required for groups."
        },
        "composite": {
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/R-CF/zarr_convention_ref/main/schema.json#/$defs/ref"
          }
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis"
          }
        }
      },
      "anyOf": [
        { "required": ["composite"] },
        { "required": ["axes"] }
      ],
      "additionalProperties": true
    },
    "axis": {
      "type": "object",
      "description": "Properties of an individual axis",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the axis. Required."
        },
        "abbreviation": {
          "type": "string",
          "description": "Abbreviation of the axis, such as \"X\" or \"Y\"."
        },
        "direction": {
          "type": "string",
          "description": "The direction of increasing coordinate values. Its value must be taken from Table 48 of OGC standard \"Referencing by Coordinates\"."
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coordinates"
          }
        }
      },
      "required": ["name"],
      "additionalProperties": true
    },
    "coordinates": {
      "type": "object",
      "description": "Properties of a set of coordinates",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the set of coordinates."
        },
        "unit": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "https://raw.githubusercontent.com/clbarnes/zarr-convention-uom/refs/tags/v1/schema.json#/$defs/uom" }
          ]
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "values": {
          "$ref": "#/$defs/values"
        },
        "boundaries": {
          "$ref": "#/$defs/boundaries"
        }
      },
      "required": ["values"],
      "additionalProperties": true
    },
    "time": {
      "type": "object",
      "description": "The time definition of a set of coordinates.",
      "properties": {
        "reference": {
          "type": "string"
        },
        "calendar": {
          "type": "string"
        }
      },
      "required": ["reference"],
      "additionalProperties": true
    },
    "values": {
      "type": "object",
      "description": "The coordinate values of an axis",
      "properties": {
        "regular": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Initial coordinate value (at shape index 0) and increment between successive coordinates.",
          "minItems": 2,
          "maxItems": 2
        },
        "external": {
          "$ref": "https://raw.githubusercontent.com/R-CF/zarr_convention_ref/main/schema.json#/$defs/ref",
          "description": "Path to a 1-dimensional array with coordinate values."
        },
        "explicit": {
          "type": "array",
          "description": "JSON array of coordinate values."
        }
      },
      "oneOf": [
        { "required": ["regular"] },
        { "required": ["external"] },
        { "required": ["explicit"] }
      ],
      "additionalProperties": true
    },
    "boundaries": {
      "type": "object",
      "description": "The boundary values around coordinate values of an axis",
      "properties": {
        "regular": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "JSON array with the extent below and above the coordinate value.",
          "minItems": 2,
          "maxItems": 2
        },
        "external": {
          "$ref": "https://raw.githubusercontent.com/R-CF/zarr_convention_ref/main/schema.json#/$defs/ref",
          "description": "Path to an array providing boundary values."
        }
      },
      "oneOf": [
        { "required": ["regular"] },
        { "required": ["external"] }
      ],
      "additionalProperties": true
    }
  }
}
