{
  "zarr_format": 3,
  "node_type": "array",
  "shape": [1200, 180, 288],
  "dimension_names": ["time", "lat", "lon"],
  "attributes": {
    "zarr_conventions": [
      {
        "schema_url": "https://raw.githubusercontent.com/R-CF/zarr_convention_cs/tags/v1/schema.json",
        "name": "cs"
      },
      {
        "schema_url": "https://raw.githubusercontent.com/R-CF/zarr_convention_ref/main/schema.json",
        "name": "ref"
      }
    ],
    "cs": {
      "axes": [
        {
          "name": "lon",
          "abbreviation": "X",
          "direction": "east",
          "coordinates": [
            {
              "unit": "degrees",
              "values": {
                "regular": [0.625, 1.25]
              },
              "boundaries": {
                "regular": [-0.625, 0.625]
              }
            }
          ]
        },
        {
          "name": "lat",
          "abbreviation": "Y",
          "direction": "north",
          "coordinates": [
            {
              "unit": "degrees",
              "values": {
                "regular": [-89.5, 1]
              },
              "boundaries": {
                "regular": [-0.5, 0.5]
              }
            }
          ]
        },
        {
          "name": "time",
          "abbreviation": "T",
          "direction": "future",
          "coordinates": [
            {
              "time": {
                "reference": "days since 1850-01-01",
                "calendar": "noleap"
              },
              "values": {
                "external": {
                  "array": "time"
                }
              },
              "boundaries": {
                "external": {
                  "array": "time_bnds"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
